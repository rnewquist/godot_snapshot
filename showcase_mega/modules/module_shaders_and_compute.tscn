[sub_resource type="Shader" id="Shader_terrain_fbm"]
code = "shader_type spatial;
render_mode cull_back, specular_schlick_ggx;

uniform float ridge_scale : hint_range(1.0, 8.0) = 2.6;
uniform float ridge_gain : hint_range(0.5, 2.5) = 1.65;
uniform float displacement_amp : hint_range(0.0, 0.45) = 0.16;
uniform float strata_freq : hint_range(2.0, 20.0) = 9.0;
uniform float snow_line : hint_range(0.2, 0.95) = 0.58;

varying float v_ridge_h;
varying vec3 v_local_pos;
varying vec3 v_local_norm;

const mat3 NOISE_ROT = mat3(
	vec3(0.00, 0.80, 0.60),
	vec3(-0.80, 0.36, -0.48),
	vec3(-0.60, -0.48, 0.64)
);

float hash31(vec3 p3) {
	p3 = fract(p3 * 0.1031);
	p3 += dot(p3, p3.zyx + 31.32);
	return fract((p3.x + p3.y) * p3.z);
}

float noise3d(vec3 x) {
	vec3 i = floor(x);
	vec3 f = fract(x);
	vec3 u = f * f * (3.0 - 2.0 * f);
	float n000 = hash31(i + vec3(0.0, 0.0, 0.0));
	float n100 = hash31(i + vec3(1.0, 0.0, 0.0));
	float n010 = hash31(i + vec3(0.0, 1.0, 0.0));
	float n110 = hash31(i + vec3(1.0, 1.0, 0.0));
	float n001 = hash31(i + vec3(0.0, 0.0, 1.0));
	float n101 = hash31(i + vec3(1.0, 0.0, 1.0));
	float n011 = hash31(i + vec3(0.0, 1.0, 1.0));
	float n111 = hash31(i + vec3(1.0, 1.0, 1.0));
	float nx00 = mix(n000, n100, u.x);
	float nx10 = mix(n010, n110, u.x);
	float nx01 = mix(n001, n101, u.x);
	float nx11 = mix(n011, n111, u.x);
	return mix(mix(nx00, nx10, u.y), mix(nx01, nx11, u.y), u.z);
}

float fbm_ridge3d(vec3 p, float gain_w) {
	float sum = 0.0;
	float amp = 0.55;
	float prev_w = 1.0;
	vec3 wp = p;
	for (int i = 0; i < 3; i++) {
		float r = 1.0 - abs(noise3d(wp) * 2.0 - 1.0);
		r = r * r * prev_w;
		prev_w = clamp(r * gain_w, 0.1, 1.0);
		sum += r * amp;
		wp = NOISE_ROT * wp * 2.03;
		amp *= 0.5;
	}
	return sum;
}

void vertex() {
	vec3 base_dir = VERTEX / max(length(VERTEX), 0.0001);
	float h = fbm_ridge3d(base_dir * ridge_scale, ridge_gain);
	float hx = fbm_ridge3d((base_dir + vec3(0.04, 0.0, 0.0)) * ridge_scale, ridge_gain);
	float hz = fbm_ridge3d((base_dir + vec3(0.0, 0.0, 0.04)) * ridge_scale, ridge_gain);
	VERTEX += NORMAL * (h * displacement_amp);
	vec3 grad = vec3(hx - h, 0.0, hz - h) * (displacement_amp * 8.0);
	NORMAL = normalize(NORMAL - grad);
	v_ridge_h = h;
	v_local_pos = VERTEX;
	v_local_norm = NORMAL;
}

void fragment() {
	float up_slope = clamp(dot(v_local_norm, vec3(0.0, 1.0, 0.0)) * 0.5 + 0.5, 0.0, 1.0);
	float strata = 0.5 + 0.5 * sin(v_local_pos.y * strata_freq + v_ridge_h * 4.5);
	vec3 tier0_slate = vec3(0.14, 0.18, 0.25);
	vec3 tier1_granite = mix(vec3(0.35, 0.33, 0.30), vec3(0.48, 0.43, 0.38), strata);
	vec3 tier2_moss = vec3(0.26, 0.46, 0.22);
	vec3 tier3_snow = vec3(0.93, 0.96, 0.99);
	float elev = clamp(v_ridge_h, 0.0, 1.0);
	vec3 col = mix(tier0_slate, tier1_granite, smoothstep(0.18, 0.45, elev));
	col = mix(col, tier2_moss, smoothstep(0.35, 0.62, elev) * smoothstep(0.45, 0.75, up_slope));
	float snow_mask = smoothstep(snow_line, snow_line + 0.18, elev + up_slope * 0.15);
	ALBEDO = mix(col, tier3_snow, snow_mask);
	ROUGHNESS = mix(0.82, 0.35, snow_mask);
	METALLIC = 0.05;
}
"

