[sub_resource type="Shader" id="Shader_instance_batch"]
code = "shader_type spatial;
render_mode cull_disabled, specular_schlick_ggx;

uniform float base_roughness : hint_range(0.05, 0.95) = 0.22;
uniform float morph_amount : hint_range(0.0, 1.0) = 0.0;
instance uniform vec4 instance_tint : source_color = vec4(0.95, 0.55, 0.15, 1.0);
instance uniform float pulse_speed : hint_range(0.5, 8.0) = 2.0;

void vertex() {
	vec3 p = VERTEX;
	float r = max(length(p), 0.0001);
	vec3 dir = p / r;
	float theta = atan(dir.x, dir.z);
	float phi = acos(clamp(dir.y, -1.0, 1.0));
	float arc_r = r * phi * 0.55;
	vec3 flat_disc = vec3(arc_r * sin(theta), p.y * 0.18, arc_r * cos(theta));
	VERTEX = mix(p, flat_disc, morph_amount);
	NORMAL = normalize(mix(NORMAL, vec3(0.0, 1.0, 0.0), morph_amount * 0.75));
}

void fragment() {
	float fresnel = pow(clamp(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 0.0, 1.0), 3.0);
	float pulse = 0.5 + 0.5 * sin(TIME * pulse_speed + UV.y * 6.28318);
	ALBEDO = instance_tint.rgb * (0.75 + 0.25 * pulse);
	EMISSION = instance_tint.rgb * (fresnel * 0.55 + pulse * 0.18);
	ROUGHNESS = base_roughness;
	METALLIC = 0.65;
}
"

