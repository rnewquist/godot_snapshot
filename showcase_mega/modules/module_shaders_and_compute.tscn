[sub_resource type="Shader" id="Shader_foliage_cantilever"]
code = "shader_type spatial;
render_mode cull_disabled, specular_schlick_ggx;

uniform float wind_strength : hint_range(0.0, 1.2) = 0.38;
uniform float wind_speed : hint_range(0.5, 6.0) = 2.4;
uniform float blade_length : hint_range(0.3, 2.0) = 0.95;
uniform float lod_max_distance : hint_range(5.0, 80.0) = 32.0;
uniform vec4 root_color : source_color = vec4(0.09, 0.26, 0.08, 1.0);
uniform vec4 tip_color : source_color = vec4(0.44, 0.76, 0.22, 1.0);

varying float v_height_t;
varying float v_cam_dist;
varying vec3 v_inst_tint;

float bayer4x4(vec2 frag_coord) {
	ivec2 p = ivec2(mod(frag_coord, 4.0));
	const float bayer[16] = float[16](
		0.0 / 16.0, 8.0 / 16.0, 2.0 / 16.0, 10.0 / 16.0,
		12.0 / 16.0, 4.0 / 16.0, 14.0 / 16.0, 6.0 / 16.0,
		3.0 / 16.0, 11.0 / 16.0, 1.0 / 16.0, 9.0 / 16.0,
		15.0 / 16.0, 7.0 / 16.0, 13.0 / 16.0, 5.0 / 16.0
	);
	return bayer[p.y * 4 + p.x];
}

void vertex() {
	float h_t = clamp(1.0 - UV.y, 0.0, 1.0);
	float bend = h_t * h_t;
	float phase = INSTANCE_CUSTOM.x + TIME * wind_speed;
	float stiffness = max(INSTANCE_CUSTOM.y, 0.35);
	vec2 disp_xz = vec2(sin(phase), cos(phase * 0.7)) * (wind_strength / stiffness) * bend;
	float L = max(blade_length * max(INSTANCE_CUSTOM.z, 0.5), 0.2);
	float disp_sq = min(dot(disp_xz, disp_xz), L * L * 0.88);
	float conserved_y = sqrt(max(0.0001, L * L - disp_sq));
	VERTEX.xz += disp_xz;
	VERTEX.y = (VERTEX.y * L) - (L - conserved_y) * h_t;
	NORMAL = normalize(vec3(-disp_xz.x * 0.65, 1.0, -disp_xz.y * 0.65));
	vec3 world_origin = (MODEL_MATRIX * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
	v_cam_dist = length(INV_VIEW_MATRIX[3].xyz - world_origin);
	v_height_t = h_t;
	v_inst_tint = COLOR.rgb;
}

void fragment() {
	float lod_vis = 1.0 - smoothstep(lod_max_distance * 0.70, lod_max_distance, v_cam_dist);
	if (lod_vis < bayer4x4(FRAGCOORD.xy)) {
		discard;
	}
	vec3 blade_col = mix(root_color.rgb, tip_color.rgb, v_height_t) * mix(vec3(1.0), v_inst_tint, 0.35);
	ALBEDO = blade_col;
	ROUGHNESS = mix(0.75, 0.38, v_height_t);
	BACKLIGHT = tip_color.rgb * (v_height_t * 0.42);
}
"

