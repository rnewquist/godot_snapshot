[sub_resource type="Shader" id="Shader_tactile_wool"]
code = "shader_type spatial;
render_mode cull_back, diffuse_burley, specular_schlick_ggx;

uniform vec4 wool_tint : source_color = vec4(0.86, 0.34, 0.24, 1.0);
uniform vec4 stitch_tint : source_color = vec4(0.97, 0.92, 0.78, 1.0);
uniform float rim_power : hint_range(1.0, 8.0) = 3.0;
uniform float subsurf_scatter : hint_range(0.0, 1.0) = 0.48;
uniform float fiber_freq : hint_range(40.0, 300.0) = 140.0;
uniform float stitch_freq : hint_range(6.0, 36.0) = 18.0;

float hash12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

void fragment() {
	float stitch_fade = 1.0 - smoothstep(0.25, 0.70, length(fwidth(UV * stitch_freq)));
	float fiber_noise = hash12(floor(UV * fiber_freq)) * 2.0 - 1.0;
	vec2 stitch_p = vec2(fract(UV.x * stitch_freq) - 0.5, (fract(UV.y * 3.0) - 0.5) * 4.5);
	stitch_p.x -= clamp(stitch_p.x, -0.22, 0.22);
	float stitch_mask = (1.0 - smoothstep(-0.04, 0.04, length(stitch_p) - 0.11)) * stitch_fade;
	float fresnel_rim = pow(clamp(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 0.0, 1.0), rim_power);
	vec3 felt_col = wool_tint.rgb + vec3(fiber_noise * 0.06) + vec3(fresnel_rim * 0.22);
	ALBEDO = mix(felt_col, stitch_tint.rgb, stitch_mask);
	ROUGHNESS = mix(0.92, 0.48, stitch_mask);
	METALLIC = 0.02;
	BACKLIGHT = wool_tint.rgb * subsurf_scatter;
}
"

