[sub_resource type="Shader" id="Shader_wave"]
code = "shader_type spatial;
render_mode cull_disabled, specular_schlick_ggx;

uniform float wave_frequency : hint_range(1.0, 10.0) = 4.0;
uniform float wave_amplitude : hint_range(0.05, 1.0) = 0.25;
uniform float wave_speed : hint_range(0.5, 10.0) = 3.0;
uniform vec4 deep_color : source_color = vec4(0.06, 0.28, 0.62, 1.0);
uniform vec4 crest_color : source_color = vec4(0.24, 0.82, 0.98, 1.0);
uniform float roughness_val : hint_range(0.05, 1.0) = 0.18;
uniform float metallic_val : hint_range(0.0, 1.0) = 0.45;

varying float v_wave_h;

void vertex() {
	float phase_x = VERTEX.x * wave_frequency + TIME * wave_speed;
	float phase_z = VERTEX.z * (wave_frequency * 0.75) - TIME * (wave_speed * 0.65);
	float h = sin(phase_x) * wave_amplitude + cos(phase_z) * (wave_amplitude * 0.45);
	float dh_dx = cos(phase_x) * wave_frequency * wave_amplitude;
	float dh_dz = -sin(phase_z) * (wave_frequency * 0.75) * (wave_amplitude * 0.45);
	VERTEX.y += h;
	NORMAL = normalize(vec3(-dh_dx, 1.0, -dh_dz));
	v_wave_h = clamp(h / max(wave_amplitude * 1.45, 0.001) * 0.5 + 0.5, 0.0, 1.0);
}

void fragment() {
	float fresnel = pow(clamp(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), 0.0, 1.0), 3.0);
	float ripple_band = 0.5 + 0.5 * sin(UV.x * 12.0 + UV.y * 8.0);
	vec3 base_col = mix(deep_color.rgb, crest_color.rgb, clamp(v_wave_h * 0.8 + ripple_band * 0.2, 0.0, 1.0));
	ALBEDO = mix(base_col, vec3(0.92, 0.98, 1.0), fresnel * 0.35);
	EMISSION = crest_color.rgb * (v_wave_h * v_wave_h * 0.18 + fresnel * 0.12);
	ROUGHNESS = roughness_val;
	METALLIC = metallic_val;
}
"

