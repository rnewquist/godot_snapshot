[sub_resource type="Shader" id="Shader_voronoi_masonry"]
code = "shader_type spatial;
render_mode cull_back, specular_schlick_ggx;

uniform float cell_scale : hint_range(2.0, 16.0) = 6.0;
uniform float mortar_width : hint_range(0.02, 0.25) = 0.08;
uniform float cotangent_bump_scale : hint_range(0.0, 2.0) = 0.85;
uniform float masonry_mode_mix : hint_range(0.0, 1.0) = 1.0;
uniform vec4 stone_color : source_color = vec4(0.46, 0.49, 0.54, 1.0);
uniform vec4 mortar_color : source_color = vec4(0.16, 0.17, 0.19, 1.0);

vec2 hash22(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.xx + p3.yz) * p3.zy);
}

float hash12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

vec2 voronoi_3x3_dome(vec2 uv, float jitter) {
	vec2 n = floor(uv);
	vec2 f = fract(uv);
	float d1 = 8.0;
	float id = 0.0;
	for (int j = -1; j <= 1; j++) {
		for (int i = -1; i <= 1; i++) {
			vec2 g = vec2(float(i), float(j));
			vec2 r = g + mix(vec2(0.5), hash22(n + g), jitter) - f;
			float d = dot(r, r);
			if (d < d1) {
				d1 = d;
				id = hash12(n + g);
			}
		}
	}
	return vec2(clamp(1.0 - d1, 0.0, 1.0), id);
}

vec2 voronoi_5x5_bisector(vec2 uv, float jitter) {
	vec2 n = floor(uv);
	vec2 f = fract(uv);
	vec2 mg = vec2(0.0);
	vec2 mr = vec2(0.0);
	float md = 8.0;
	for (int j = -1; j <= 1; j++) {
		for (int i = -1; i <= 1; i++) {
			vec2 g = vec2(float(i), float(j));
			vec2 r = g + mix(vec2(0.5), hash22(n + g), jitter) - f;
			float d = dot(r, r);
			if (d < md) {
				md = d;
				mr = r;
				mg = g;
			}
		}
	}
	float edge_d = 8.0;
	for (int j = -2; j <= 2; j++) {
		for (int i = -2; i <= 2; i++) {
			vec2 g = mg + vec2(float(i), float(j));
			vec2 r = g + mix(vec2(0.5), hash22(n + g), jitter) - f;
			vec2 diff = r - mr;
			float diff_len_sq = dot(diff, diff);
			if (diff_len_sq > 0.0001) {
				vec2 bisector_dir = diff * inversesqrt(diff_len_sq);
				edge_d = min(edge_d, dot(0.5 * (mr + r), bisector_dir));
			}
		}
	}
	return vec2(edge_d, hash12(n + mg));
}

vec3 perturb_normal_cotangent(vec3 view_n, vec3 view_pos, vec2 uv, vec2 dh_duv, float scale) {
	vec3 dp1 = dFdx(view_pos);
	vec3 dp2 = dFdy(view_pos);
	vec2 duv1 = dFdx(uv);
	vec2 duv2 = dFdy(uv);
	vec3 dp2perp = cross(dp2, view_n);
	vec3 dp1perp = cross(view_n, dp1);
	vec3 T = dp2perp * duv1.x + dp1perp * duv2.x;
	vec3 B = dp2perp * duv1.y + dp1perp * duv2.y;
	float invmax = inversesqrt(max(dot(T, T), dot(B, B)) + 1e-8);
	return normalize(view_n - (T * dh_duv.x + B * dh_duv.y) * (scale * invmax));
}

void fragment() {
	vec2 scaled_uv = UV * cell_scale;
	float fw = length(fwidth(scaled_uv));
	float mip_fade = 1.0 - smoothstep(0.25, 0.75, fw);
	vec2 dome_res = voronoi_3x3_dome(scaled_uv, 0.78);
	vec2 masonry_res = voronoi_5x5_bisector(scaled_uv, 0.78);
	float stone_bevel = smoothstep(mortar_width * 0.5, mortar_width * 1.6, masonry_res.x);
	float h_profile = mix(dome_res.x, stone_bevel, masonry_mode_mix) * mip_fade;
	float cell_id = mix(dome_res.y, masonry_res.y, masonry_mode_mix);
	vec2 dh_duv = vec2(dFdx(h_profile), dFdy(h_profile));
	NORMAL = perturb_normal_cotangent(NORMAL, VERTEX, scaled_uv, dh_duv, cotangent_bump_scale);
	vec3 varied_stone = stone_color.rgb * (0.82 + 0.34 * cell_id);
	ALBEDO = mix(mortar_color.rgb, varied_stone, h_profile);
	ROUGHNESS = mix(0.92, 0.52, h_profile);
	METALLIC = 0.08;
}
"

