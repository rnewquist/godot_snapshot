[sub_resource type="Shader" id="Shader_canvas_sdf"]
code = "shader_type canvas_item;

uniform vec4 ring_color : source_color = vec4(0.22, 0.86, 1.0, 1.0);
uniform vec4 core_color : source_color = vec4(0.95, 0.55, 0.18, 1.0);
uniform float ring_frequency : hint_range(2.0, 16.0) = 6.0;
uniform float bevel_radius : hint_range(0.15, 0.48) = 0.36;

float sd_hex_flat(vec2 p, float r) {
	const vec3 k = vec3(-0.866025404, 0.5, 0.577350269);
	p = abs(p);
	p -= 2.0 * min(dot(k.xy, p), 0.0) * k.xy;
	p -= vec2(clamp(p.x, -k.z * r, k.z * r), r);
	return length(p) * sign(p.y);
}

void fragment() {
	vec2 p = UV - vec2(0.5);
	float d_hex = sd_hex_flat(p, bevel_radius);
	float ring_wave = 0.5 + 0.5 * sin(d_hex * ring_frequency * 6.28318 - TIME * 3.2);
	float inside_mask = 1.0 - smoothstep(-0.02, 0.02, d_hex);
	float rim_glow = exp(-abs(d_hex) * 14.0);
	vec3 col = mix(ring_color.rgb * ring_wave, core_color.rgb, inside_mask * 0.65) + ring_color.rgb * rim_glow * 0.75;
	COLOR = vec4(col, 0.95);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_canvas_sdf"]
