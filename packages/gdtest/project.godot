; Engine configuration file for GDTest 3.0 standalone package
; It's best edited using the editor UI and not directly,
; but it can also be edited by hand.

config_version=5

[application]

config/name="GDTest"
config/description="Godot Scene Snapshot (GSS) & Deterministic Testing Framework for Godot 4.x"
config/version="3.0.0"
config/features=PackedStringArray("4.3", "4.4", "4.5", "4.6", "Forward Plus")
config/icon="res://addons/gdtest/icon.svg"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdtest/plugin.cfg")
